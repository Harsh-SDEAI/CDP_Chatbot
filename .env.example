# ------------------------------------------------------------------
# Environment template for export_chat_api.py
#
# Copy this file to ".env" and fill in the two connection strings.
#   cp .env.example .env
# The real .env is gitignored and stays on your machine / server.
#
# IMPORTANT: save .env as UTF-8 (plain ASCII here, so this is safe to copy).
# ------------------------------------------------------------------

# DB1 - the chat-history database (where CDPChatHistory lives).
# Full ODBC connection string on a single line, e.g.:
# CHAT_DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=your_server;DATABASE=your_db;UID=your_user;PWD=your_password;
CHAT_DB_CONNECTION_STRING=

# DB2 - the CDP2000 database (Roster + Team) on a different server.
# Full ODBC connection string on a single line, e.g.:
# CDP2000_DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=your_server;DATABASE=CDP2000;UID=your_user;PWD=your_password;ApplicationIntent=ReadOnly;
CDP2000_DB_CONNECTION_STRING=

# API key that QA must send in the "X-API-Key" header to use /export-chat.
# Pick any strong random string. Requests without this exact value get 401.
EXPORT_API_KEY=
