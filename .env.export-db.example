# ------------------------------------------------------------------
# Environment template for export_chat_to_db.py
#
# Copy this file to ".env" and fill in the values.
#   cp .env.export-db.example .env
# The real .env is gitignored and stays on your machine / server.
#
# Save .env as UTF-8 (this template is plain ASCII, so it is safe to copy).
# ------------------------------------------------------------------

# SOURCE database (CDPApp) - holds both CDPChatHistory and UserRegistration.
# Same value the existing export_chat_api.py uses, so one .env serves both.
# Full ODBC connection string on a single line, e.g.:
# CHAT_DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=your_server;DATABASE=CDPApp;UID=your_user;PWD=your_password;ApplicationIntent=ReadOnly;
CHAT_DB_CONNECTION_STRING=

# TARGET database - the OTHER database that holds the CDPChatReview table
# (created by migration_chat_review.sql). This is where rows are written, so
# it must be writable (do NOT add ApplicationIntent=ReadOnly here).
# TARGET_DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=your_server;DATABASE=CDPReview;UID=your_user;PWD=your_password;
TARGET_DB_CONNECTION_STRING=

# Date range to export (inclusive, YYYY-MM-DD). The end date includes the
# whole day. Example below exports all of 2026-01-01 through 2026-05-31.
EXPORT_START_DATE=2026-01-01
EXPORT_END_DATE=2026-05-31
