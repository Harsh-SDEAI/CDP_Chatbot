<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>
        <httpPlatform processPath="D:\CDPGPT\api\cdpchatbot\Scripts\python.exe"
                     arguments="-m uvicorn CDPGPT:app --host 0.0.0.0 --port %HTTP_PLATFORM_PORT% --workers 8"
                     stdoutLogEnabled="true"
                     stdoutLogFile="D:\CDPGPT\api\logs\python.log"
                     startupTimeLimit="180">
            <environmentVariables>
                <environmentVariable name="PYTHONPATH" value="D:\CDPGPT\api" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>